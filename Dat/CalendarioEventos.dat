' CalendarioEventos.dat - automatic events of the server. Hour is the local time of the server (ART on the VM).
' Read at server start from Dat and again by the GM chat command ~CALENDARIO RECARGAR (no restart needed).
' Format notes: the parser takes any line that has an equals sign as a key, so no equals sign in comments.
'
' [CALENDARIO] defaults: VentanaMin 30 (range 5-180), ReintentoMin 10 (5-60), AvisoPrevioMin 5 (0-30, parsed
' but no notice is sent yet), BloquearConInvasion 1 (an active invasion blocks the lobby turnos).
'
' [TURNOS]: up to 48 lines named Turno1 to Turno48 (gaps allowed). Value format:
'     Dias|HH:MM|VARIANTE   or   Dias|HH:MM|VARIANTE|VentanaMin
' Dias is TODOS or a list of DOM,LUN,MAR,MIE,JUE,VIE,SAB. A turno opens at the first minute inside
' [HH:MM, HH:MM + window), retries every ReintentoMin minutes while blocked, and ends OMITIDO if the window
' closes. One open per turno per date, kept in the table event_calendar_run (survives a restart).
' A window that crosses midnight belongs to the day it started.
'
' [VARIANTE_<NAME>]: Modo is DEATHMATCH, CACERIA, CAPTURA or NAVAL (INVASION is not enabled in this build).
' Optional keys and defaults: MinLevel 1, MaxLevel 47, MinPlayers 2, MaxPlayers 20, TeamSize 0, TeamType 1,
' RoundNumber 1 (CAPTURA 3), InscriptionFee 0, MinOnline (same as MinPlayers; players online without staff),
' Description (empty: the announcement uses the name of the mode, max 40 characters).
' Only the variants that a turno names are read.
'
' Real calendar decided with the owner on 2026-11-25 (see ia/decisiones.md). Nothing opens while the
' feature toggle automatic_events is 0; an Admin turns it on live with /FEATURETOGGLE automatic_events 1.

[CALENDARIO]
Version=1
VentanaMin=30
ReintentoMin=10
BloquearConInvasion=1
AvisoPrevioMin=5

[TURNOS]
Turno1=LUN,MAR,MIE,JUE,VIE,SAB|21:00|CACERIA_BAJOS
Turno2=LUN,MIE,VIE|22:00|DM_MEDIOS
Turno3=MAR,JUE|22:00|DM_ALTOS
Turno4=SAB|22:00|CTF_ALTOS
Turno5=DOM|19:00|DM_MEDIOS
Turno6=DOM|22:00|DM_ALTOS

[VARIANTE_CACERIA_BAJOS]
Modo=CACERIA
MinLevel=1
MaxLevel=24
MinPlayers=2
MaxPlayers=20
InscriptionFee=500
MinOnline=4
Description=Cacería nivel 1 a 24

[VARIANTE_DM_MEDIOS]
Modo=DEATHMATCH
MinLevel=25
MaxLevel=35
MinPlayers=2
MaxPlayers=20
TeamType=1
RoundNumber=1
InscriptionFee=3000
MinOnline=4
Description=DeathMatch nivel 25 a 35

[VARIANTE_DM_ALTOS]
Modo=DEATHMATCH
MinLevel=36
MaxLevel=47
MinPlayers=2
MaxPlayers=20
TeamType=1
RoundNumber=1
InscriptionFee=6000
MinOnline=4
Description=DeathMatch nivel 36 a 47

[VARIANTE_CTF_ALTOS]
Modo=CAPTURA
MinLevel=25
MaxLevel=47
MinPlayers=4
MaxPlayers=20
RoundNumber=3
InscriptionFee=5000
MinOnline=8
Description=Captura la Bandera nivel 25 a 47
